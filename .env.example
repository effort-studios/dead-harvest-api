# Copie para .env e ajuste se precisar
DATABASE_URL="postgresql://deadharvest:deadharvest@localhost:5432/deadharvest"
PORT=3333
# URL(s) do front liberadas no CORS; mais de uma separadas por vírgula
# (ex.: "http://localhost:5173,http://192.168.0.10:5173" para testar também pela rede)
WEB_URL="http://localhost:5173"

# Segredo (mínimo 32 caracteres) que assina os códigos de redefinição de senha. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres"

# Duração de um dia inteiro do jogo, em segundos. O relógio do jogo é linear (24h no dia todo):
# 1440 = 24 minutos, 1 s real = 1 min no jogo. O front lê este valor em GET /game/catalog.
DAY_LENGTH_SECONDS=1440

# Início do mundo (meia-noite do dia 1): o relógio do jogo conta a partir daqui e é igual para todos os
# jogadores. Mudar este valor muda o dia e a hora de todo mundo.
# WORLD_EPOCH=2026-10-27T00:00:00Z

# SameSite do cookie de login: "lax" (padrão) com front e API no mesmo site; "none" quando estão em
# subdomínios diferentes de up.railway.app (só funciona com HTTPS)
# COOKIE_SAMESITE=lax

# Fazendeiro: velocidade (células por segundo) e duração do gesto de arar/plantar/colher (ms)
# FARMER_WALK_SPEED=3.4
# FARMER_ACT_MS=550
