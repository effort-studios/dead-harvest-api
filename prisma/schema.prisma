generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenção do banco: tabelas no plural e colunas em snake_case (@@map / @map).
// No código TypeScript continua camelCase.
//
// O servidor é a fonte da verdade do jogo: nada de estado em JSON. Duas famílias de tabelas:
//   catálogo (items, crops, trees, machines, recipes, recipe_inputs, animals): regras do jogo, iguais para
//   todos, populadas por migration;
//   estado do jogador (saves, plots, tiles, inventory_items, tree_harvests, save_machines, machine_jobs,
//   save_animals): tudo com FK.

enum ItemKind {
  seed
  fruit
  crop // colheita de uma planta (vai para o armazém)
  animal_product // ovo, leite, lã
  product // feito numa máquina

  @@map("item_kind")
}

enum JobAction {
  till
  plant
  harvest
  harvest_tree
  fertilize
  collect_machine
  collect_barn
  water
  refill_can
  move
  untill

  @@map("job_action")
}

enum TileState {
  tilled // arado; terra sem arar não tem linha (é a ausência de linha)
  planted

  @@map("tile_state")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique // sempre em minúsculas (CHECK no banco)
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  // Quando o e-mail foi confirmado pelo código; null = conta criada mas ainda sem confirmar (não entra)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  // Avatar: ids das peças (opções em src/game/avatar.ts; o banco confere com CHECK)
  avatarSkin      String @default("light") @map("avatar_skin")
  avatarFace      String @default("happy") @map("avatar_face")
  avatarEyes      String @default("green") @map("avatar_eyes")
  avatarHair      String @default("short") @map("avatar_hair")
  avatarHairColor String @default("brown") @map("avatar_hair_color")
  avatarHat       String @default("straw") @map("avatar_hat")
  avatarBeard     String @default("none") @map("avatar_beard")
  avatarOutfit    String @default("overalls_blue") @map("avatar_outfit")

  save               Save?
  sessions           Session[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]

  @@map("users")
}

// Sessão de login. O token vai para o navegador em um cookie; aqui só fica o hash dele,
// então um vazamento do banco não entrega sessões válidas.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// Pedido de redefinição de senha: um código de 6 dígitos enviado por e-mail, de uso único e curta duração
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") // HMAC do código; o código em si nunca é guardado
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts  Int       @default(0) // erros de código; passou do limite, o pedido morre
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("password_resets")
}

// Código de confirmação do e-mail no cadastro (mesma mecânica do PasswordReset)
model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") // HMAC do código; o código em si nunca é guardado
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts  Int       @default(0) // erros de código; passou do limite, o pedido morre
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("email_verifications")
}

// ---------- Catálogo ----------

// Tudo que pode ficar no inventário: sementes, frutas, colheitas, produtos dos animais e das máquinas.
// O id é um slug estável ("corn", "apple") e é a chave usada pelo jogo.
model Item {
  id        String   @id
  kind      ItemKind
  name      String
  buyPrice  Int?     @map("buy_price") // preço na loja; nulo = não se compra
  sellPrice Int?     @map("sell_price") // preço de venda; nulo = não se vende
  sortOrder Int      @map("sort_order")

  crop             Crop?
  harvestOf        Crop?           @relation("CropHarvest")
  trees            Tree[]
  inventory        InventoryItem[]
  recipeOutputs    Recipe[]
  recipeInputs     RecipeInput[]
  animalFeeds      Animal[]        @relation("AnimalFeed")
  animalProducts   Animal[]        @relation("AnimalProduct")
  animalByproducts Animal[]        @relation("AnimalByproduct")

  @@map("items")
}

model Crop {
  id            String @id
  name          String
  growSeconds   Int    @map("grow_seconds") // tempo até amadurecer
  seedItemId    String @unique @map("seed_item_id")
  seedItem      Item   @relation(fields: [seedItemId], references: [id])
  // Colher dá 1 deste item (vai para o armazém; o preço de venda é o do item)
  harvestItemId String @unique @map("harvest_item_id")
  harvestItem   Item   @relation("CropHarvest", fields: [harvestItemId], references: [id])

  tiles Tile[]

  @@map("crops")
}

// Árvores frutíferas do cenário: as mesmas para todos os jogadores
model Tree {
  id               String @id
  fruitItemId      String @map("fruit_item_id")
  fruitItem        Item   @relation(fields: [fruitItemId], references: [id])
  row              Int // posição no mapa do mundo (pode ser negativa)
  col              Int
  fruitsPerHarvest Int    @map("fruits_per_harvest")
  regrowSeconds    Int    @map("regrow_seconds")

  harvests TreeHarvest[]

  @@index([fruitItemId])
  @@map("trees")
}

// Máquinas do quintal: cada uma tem lugar fixo no mapa e o jogador compra uma de cada
model Machine {
  id        String @id
  name      String
  buyPrice  Int    @map("buy_price")
  size      Int // ocupa size x size células do mapa (CHECK 1..3)
  queueSize Int    @map("queue_size") // quantas receitas cabem na fila (prontas e não coletadas contam)
  sortOrder Int    @map("sort_order")

  recipes Recipe[]
  owners  SaveMachine[]

  @@map("machines")
}

// Receita de uma máquina: ingredientes (recipe_inputs) -> `outputQuantity` de um item, em `seconds`
model Recipe {
  id             String  @id
  machineId      String  @map("machine_id")
  machine        Machine @relation(fields: [machineId], references: [id])
  outputItemId   String  @map("output_item_id")
  outputItem     Item    @relation(fields: [outputItemId], references: [id])
  outputQuantity Int     @map("output_quantity")
  seconds        Int
  sortOrder      Int     @map("sort_order")

  inputs RecipeInput[]
  jobs   MachineJob[]

  @@index([machineId])
  @@index([outputItemId])
  @@map("recipes")
}

model RecipeInput {
  recipeId String @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  itemId   String @map("item_id")
  item     Item   @relation(fields: [itemId], references: [id])
  quantity Int

  @@id([recipeId, itemId])
  @@index([itemId])
  @@map("recipe_inputs")
}

// Animais do celeiro: comem ração e produzem depois de um tempo
model Animal {
  id                String  @id
  name              String
  buyPrice          Int     @map("buy_price")
  feedItemId        String  @map("feed_item_id")
  feedItem          Item    @relation("AnimalFeed", fields: [feedItemId], references: [id])
  feedQuantity      Int     @map("feed_quantity")
  productItemId     String  @map("product_item_id")
  productItem       Item    @relation("AnimalProduct", fields: [productItemId], references: [id])
  produceSeconds    Int     @map("produce_seconds")
  // O que ele solta a cada coleta, além do produto (esterco); nulo = nada (CHECK animals_byproduct_check)
  byproductItemId   String? @map("byproduct_item_id")
  byproductItem     Item?   @relation("AnimalByproduct", fields: [byproductItemId], references: [id], onDelete: Restrict)
  byproductQuantity Int     @default(0) @map("byproduct_quantity")
  sortOrder         Int     @map("sort_order")

  owned SaveAnimal[]

  @@index([feedItemId])
  @@index([productItemId])
  @@index([byproductItemId])
  @@map("animals")
}

// ---------- Estado do jogador ----------

model Save {
  id            String   @id @default(uuid()) @db.Uuid
  // @unique = no máximo 1 save por usuário
  userId        String   @unique @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  money         Int      @default(100)
  // O relógio do jogo é derivado do relógio do servidor: dia e hora = tempo desde este instante
  gameStartedAt DateTime @default(now()) @map("game_started_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Fazendeiro: onde está parado (célula do mapa, com fração) e quando começa o pedido da frente da fila.
  // Enquanto a fila está vazia, farmerFreeAt é nulo.
  farmerRow    Float     @default(4) @map("farmer_row")
  farmerCol    Float     @default(-1.5) @map("farmer_col")
  farmerFreeAt DateTime? @map("farmer_free_at") @db.Timestamptz(3)
  // Último instante em que o cliente avisou a posição andando livre (WASD): o servidor confere a velocidade por ele
  farmerMovedAt DateTime? @map("farmer_moved_at") @db.Timestamptz(3)

  // Baias do celeiro; 0 = ainda não comprou o celeiro
  barnCapacity Int  @default(0) @map("barn_capacity")
  // Onde o jogador construiu o celeiro; nulos = sem celeiro (CHECK saves_barn_position_check)
  barnRow      Int? @map("barn_row")
  barnCol      Int? @map("barn_col")
  // Regador: cargas (nulo = não comprou); poço: onde o jogador construiu (nulos = sem poço)
  canCharges   Int? @map("can_charges")
  wellRow      Int? @map("well_row")
  wellCol      Int? @map("well_col")

  plots        Plot[]
  inventory    InventoryItem[]
  treeHarvests TreeHarvest[]
  farmJobs     FarmJob[]
  machines     SaveMachine[]
  machineJobs  MachineJob[]
  animals      SaveAnimal[]

  @@map("saves")
}

// Terreno 10x10; (x, y) é a posição na malha de terrenos (o inicial é 0,0)
model Plot {
  id     String @id @default(uuid()) @db.Uuid
  saveId String @map("save_id") @db.Uuid
  save   Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  x      Int
  y      Int

  tiles Tile[]

  @@unique([saveId, x, y])
  @@map("plots")
}

// Só existe linha para tile arado ou plantado; o resto do terreno é terra sem arar
model Tile {
  plotId     String    @map("plot_id") @db.Uuid
  plot       Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  row        Int       @db.SmallInt // 0..9
  col        Int       @db.SmallInt // 0..9
  state      TileState
  cropId     String?   @map("crop_id")
  crop       Crop?     @relation(fields: [cropId], references: [id], onDelete: Restrict)
  plantedAt  DateTime? @map("planted_at") @db.Timestamptz(3)
  // Adubado e regado: a planta cresce mais rápido (+30% cada); a colheita tira os dois
  fertilized Boolean   @default(false)
  watered    Boolean   @default(false)
  // Crescimento acumulado: `growth` segundos de planta até `growthAt`; daí em diante cresce na velocidade do
  // tile (utils/growth.ts). A planta amadurece quando chega a crops.grow_seconds. (CHECK tiles_growth_check)
  growth     Float     @default(0)
  growthAt   DateTime? @map("growth_at") @db.Timestamptz(3)

  @@id([plotId, row, col])
  @@index([cropId])
  @@map("tiles")
}

model InventoryItem {
  saveId   String @map("save_id") @db.Uuid
  save     Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  itemId   String @map("item_id")
  item     Item   @relation(fields: [itemId], references: [id])
  quantity Int

  @@id([saveId, itemId])
  @@index([itemId])
  @@map("inventory_items")
}

// Quando o jogador colheu cada árvore pela última vez (sem linha = nunca colheu)
model TreeHarvest {
  saveId      String   @map("save_id") @db.Uuid
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  treeId      String   @map("tree_id")
  tree        Tree     @relation(fields: [treeId], references: [id])
  harvestedAt DateTime @map("harvested_at") @db.Timestamptz(3)

  @@id([saveId, treeId])
  @@index([treeId])
  @@map("tree_harvests")
}

// Fila de trabalho do fazendeiro: um pedido por tile (ou por árvore), executado na ordem de `seq` pelo worker
// (modules/game/worker). Quando o pedido termina, a linha some. O front só enfileira e cancela.
model FarmJob {
  id        String    @id @default(uuid()) @db.Uuid
  saveId    String    @map("save_id") @db.Uuid
  save      Save      @relation(fields: [saveId], references: [id], onDelete: Cascade)
  seq       Int       @default(autoincrement())
  action    JobAction
  plotX     Int?      @map("plot_x")
  plotY     Int?      @map("plot_y")
  row       Int?      @db.SmallInt
  col       Int?      @db.SmallInt
  cropId    String?   @map("crop_id") // só no plantio
  treeId    String?   @map("tree_id") // só na colheita de árvore
  machineId String?   @map("machine_id") // só na coleta de máquina
  // Célula do mapa onde o fazendeiro precisa estar para agir (calculada ao enfileirar)
  targetRow Float     @map("target_row")
  targetCol Float     @map("target_col")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([saveId, seq])
  @@map("farm_jobs")
}

// Máquina que o jogador comprou
model SaveMachine {
  saveId    String   @map("save_id") @db.Uuid
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  machineId String   @map("machine_id")
  machine   Machine  @relation(fields: [machineId], references: [id])
  // Onde o jogador construiu (e depois arrastou); célula de cima do chão da máquina
  row       Int
  col       Int
  boughtAt  DateTime @default(now()) @map("bought_at") @db.Timestamptz(3)

  jobs MachineJob[]

  @@id([saveId, machineId])
  @@index([machineId])
  @@map("save_machines")
}

// Fila de uma máquina: cada receita começa quando a anterior fica pronta. Tempo real por timestamp (pronta em
// readyAt, mesmo com o jogo fechado); a linha some quando o fazendeiro coleta.
model MachineJob {
  id        String      @id @default(uuid()) @db.Uuid
  saveId    String      @map("save_id") @db.Uuid
  save      Save        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  machineId String      @map("machine_id")
  owner     SaveMachine @relation(fields: [saveId, machineId], references: [saveId, machineId], onDelete: Cascade)
  recipeId  String      @map("recipe_id")
  recipe    Recipe      @relation(fields: [recipeId], references: [id])
  startsAt  DateTime    @map("starts_at") @db.Timestamptz(3)
  readyAt   DateTime    @map("ready_at") @db.Timestamptz(3)

  @@index([saveId, machineId, readyAt])
  @@index([recipeId])
  @@map("machine_jobs")
}

// Animal do celeiro. Alimentado (fedAt) = produzindo; fica pronto em fedAt + animals.produce_seconds.
// Sem fedAt = com fome, parado.
model SaveAnimal {
  id        String    @id @default(uuid()) @db.Uuid
  saveId    String    @map("save_id") @db.Uuid
  save      Save      @relation(fields: [saveId], references: [id], onDelete: Cascade)
  animalId  String    @map("animal_id")
  animal    Animal    @relation(fields: [animalId], references: [id])
  fedAt     DateTime? @map("fed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([saveId])
  @@index([animalId])
  @@map("save_animals")
}
