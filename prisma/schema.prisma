generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenção do banco: tabelas no plural e colunas em snake_case (@@map / @map).
// No código TypeScript continua camelCase.
model User {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  save        Save?

  @@map("users")
}

model Save {
  id        String   @id @default(uuid()) @db.Uuid
  // @unique = no máximo 1 save por usuário
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       Int      @default(1)
  // segundos desde o amanhecer do dia (0 até o fim do dia); 120 = manhã
  time      Int      @default(120)
  money     Int      @default(100)
  plots     Json
  inventory Json
  // id da árvore -> momento (ms) da última coleta de frutas
  trees     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("saves")
}
